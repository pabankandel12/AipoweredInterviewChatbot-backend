PORT=5000
MONGODB_URI=your-mongodb-connection-string
JWT_SECRET=replace-with-a-secure-random-secret
GEMINI_API_KEY=your-gemini-api-key
# URL of the frontend allowed to call this backend. Separate multiple URLs with commas.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Render URL of the deployed ML model API (it must serve GET / and POST /interview).
FASTAPI_URL=https://your-ai-model-service.onrender.com
